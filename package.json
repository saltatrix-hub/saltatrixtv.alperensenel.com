{
  "name": "saltatrix-tv",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && vite preview",
    "build": "tsc -b && vite build",
    "test": "node --import tsx --test src/lib/xtream.test.ts",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win nsis"
  },
  "main": "electron/main.cjs",
  "description": "Modern, hızlı ve sade web/Windows IPTV oynatıcı.",
  "author": "Hüseyin Alperen Şenel",
  "license": "MIT",
  "homepage": "https://saltatrixtv.alperensenel.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/saltatrix-hub/saltatrixtv.alperensenel.com.git"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron-updater": "^6.8.9",
    "hls.js": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "wrangler": "^4.144.0"
  },
  "build": {
    "appId": "com.alperensenel.saltatrixtv",
    "productName": "Saltatrix TV",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "saltatrix-hub",
        "repo": "saltatrixtv.alperensenel.com",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Saltatrix-TV-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Saltatrix TV"
    }
  }
}
